---
import type { Lang } from "../../../i18n/config.i18n";
import type { ProductItem } from "../../../actions/products/getFeaturedProducts.action";
import productContent from "../../../data/site-product-content.json";
import ProductGallery from "../components/ProductGallery.astro";
import ProductBadges from "../components/ProductBadges.astro";

interface Props {
  product: ProductItem;
  lang: Lang;
}

const { product, lang } = Astro.props;
const t = productContent[lang] ?? productContent.es;
---

<section class="py-8 sm:py-12 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Gallery -->
      <div class="lg:col-span-6 w-full">
        <ProductGallery image={product.image} title={product.name} />
      </div>

      <!-- Right Column: Product Info & Purchase -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- Category -->
        <div class="flex items-center gap-3 flex-wrap">
          <span class="badge-pill-botanical !py-1 !px-3 uppercase tracking-wider text-xs font-bold">
            {product.category}
          </span>
        </div>

        <!-- Product Name -->
        <h1 class="text-2xl sm:text-4xl font-extrabold text-brand-green-dark tracking-tight leading-tight">
          {product.name}
        </h1>

        <!-- SKU -->
        <p class="text-xs text-gray-400 font-mono">
          {t.skuLabel} <span class="font-semibold text-gray-600">{product.sku}</span>
        </p>

        <!-- Divider -->
        <hr class="border-brand-green-border/40" />

        <!-- Description with "Ver más" / "Ver menos" toggle -->
        <div class="product-description-container space-y-2">
          <div
            id="product-description-text"
            class="line-clamp-3 text-base text-gray-700 leading-relaxed transition-all"
          >
            {product.description}
          </div>

          {
            product.description.length > 120 && (
              <button
                id="product-description-toggle"
                type="button"
                class="text-sm font-semibold text-brand-amber hover:text-brand-amber-hover hover:underline transition-colors focus:outline-hidden cursor-pointer inline-flex items-center gap-1"
                data-read-more={t.readMore}
                data-read-less={t.readLess}
                aria-expanded="false"
              >
                <span class="toggle-label">{t.readMore}</span>
                <svg
                  class="toggle-icon w-4 h-4 transition-transform duration-200"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </button>
            )
          }
        </div>

        <!-- Botanical Badges -->
        <div class="pt-2">
          <ProductBadges badges={product.badges} lang={lang} />
        </div>

        <!-- Primary Purchase CTA -->
        <div class="pt-4 space-y-3">
          <a
            href={product.amazonUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary-amber w-full !py-4 !text-base shadow-lg hover:shadow-xl flex items-center justify-center gap-3"
          >
            <!-- Shopping Cart Icon -->
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span class="font-bold">{t.buyAmazonBtn}</span>
          </a>

          <!-- Quality Guarantee Note -->
          <div class="flex items-center justify-center gap-1.5 text-xs text-gray-500 pt-1">
            <svg class="w-4 h-4 text-brand-green-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>{t.guaranteeBadge}</span>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  function setupDescriptionToggle() {
    const toggleBtn = document.getElementById("product-description-toggle");
    const descText = document.getElementById("product-description-text");
    if (!toggleBtn || !descText) return;

    const readMore = toggleBtn.getAttribute("data-read-more") || "Ver más";
    const readLess = toggleBtn.getAttribute("data-read-less") || "Ver menos";
    const labelSpan = toggleBtn.querySelector(".toggle-label");
    const iconSvg = toggleBtn.querySelector(".toggle-icon");

    // Remove any previous listener by cloning
    const newToggle = toggleBtn.cloneNode(true) as HTMLElement;
    toggleBtn.parentNode?.replaceChild(newToggle, toggleBtn);

    const newLabel = newToggle.querySelector(".toggle-label");
    const newIcon = newToggle.querySelector(".toggle-icon");

    newToggle.addEventListener("click", () => {
      const isExpanded = descText.classList.contains("line-clamp-none");

      if (isExpanded) {
        descText.classList.remove("line-clamp-none");
        descText.classList.add("line-clamp-3");
        newToggle.setAttribute("aria-expanded", "false");
        if (newLabel) newLabel.textContent = readMore;
        if (newIcon) newIcon.classList.remove("rotate-180");
      } else {
        descText.classList.remove("line-clamp-3");
        descText.classList.add("line-clamp-none");
        newToggle.setAttribute("aria-expanded", "true");
        if (newLabel) newLabel.textContent = readLess;
        if (newIcon) newIcon.classList.add("rotate-180");
      }
    });
  }

  setupDescriptionToggle();
  document.addEventListener("astro:page-load", setupDescriptionToggle);
</script>
