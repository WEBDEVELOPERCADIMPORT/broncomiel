---
import type { Lang } from "../../../i18n/config.i18n";
import type { ProductBadge } from "../../../actions/products/getFeaturedProducts.action";

interface Props {
  badges: ProductBadge[];
  lang: Lang;
}

const { badges, lang } = Astro.props;

const getBadgeSvg = (iconId: string) => {
  switch (iconId) {
    case "honey":
      return `
        <svg class="w-4 h-4 text-brand-amber shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
          <circle cx="12" cy="12" r="4" />
        </svg>
      `;
    case "sun":
      return `
        <svg class="w-4 h-4 text-brand-amber shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
      `;
    case "leaf":
      return `
        <svg class="w-4 h-4 text-brand-green-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
          <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
        </svg>
      `;
    case "family":
    default:
      return `
        <svg class="w-4 h-4 text-brand-green-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
          <path d="M16 3.13a4 4 0 0 1 0 7.75" />
        </svg>
      `;
  }
};
---

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-3">
  {
    badges.map((badge) => {
      const label = badge.label;
      return (
        <div class="badge-pill-botanical !py-2 !px-3.5 flex items-center justify-center gap-2 text-center rounded-xl font-medium shadow-2xs">
          <Fragment set:html={getBadgeSvg(badge.icon)} />
          <span class="truncate">{label}</span>
        </div>
      );
    })
  }
</div>
