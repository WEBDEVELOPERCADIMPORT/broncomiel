---
import type { Lang } from "../../../i18n/config.i18n";
import homeContent from "../../../data/site-home-content.json";
import type { Place } from "../../../actions/places/getPlaces.action";

interface Props {
  lang: Lang;
  places?: Place[];
}

const { lang, places = [] } = Astro.props;
const t = homeContent[lang] ?? homeContent.es;
const locator = t.storeLocator;

const defaultAddress =
  places.length > 0
    ? places[0].address
    : "Av. Tulum 123, Cancún, Quintana Roo";

const initialIframeSrc = `https://maps.google.com/maps?q=${encodeURIComponent(
  defaultAddress
)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
---

<section
  id={locator.id}
  class="bg-brand-diagonal-gradient text-white py-20 sm:py-28 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        {locator.title}
      </h2>
      <p class="text-base sm:text-lg text-brand-green-light leading-relaxed">
        {locator.subtitle}
      </p>
    </div>

    <!-- Main Locator Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Left Panel: Search & Store Cards -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-4">
        
        <!-- Search Input -->
        <div class="relative">
          <input
            id="store-search-input"
            type="text"
            placeholder={locator.searchPlaceholder}
            class="w-full bg-white/10 text-white placeholder-gray-300 text-sm rounded-full pl-11 pr-24 py-3.5 border border-white/20 focus:outline-hidden focus:ring-2 focus:ring-brand-amber transition backdrop-blur-md"
          />
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-300">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <button
            type="button"
            id="store-search-btn"
            class="absolute right-1.5 top-1.5 bottom-1.5 btn-primary-amber !py-1 !px-4 !text-xs"
          >
            {locator.searchBtn}
          </button>
        </div>

        <!-- Store Cards List (Rendered dynamically from places) -->
        <div id="store-list" class="space-y-3 max-h-[440px] overflow-y-auto pr-1">
          {
            places.map((place, index) => {
              const googleMapsSearchUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
                place.address
              )}`;

              return (
                <div
                  class={`store-item p-4 rounded-2xl border transition-all cursor-pointer backdrop-blur-xs flex items-center justify-between gap-3 ${
                    index === 0
                      ? "border-brand-amber bg-white/20 shadow-md ring-1 ring-brand-amber/50"
                      : "border-white/15 bg-white/10 hover:bg-white/15"
                  }`}
                  data-store-id={place.id}
                  data-address={place.address}
                  data-name={place.name}
                  data-zipcode={place.zipCode}
                >
                  <div class="space-y-1 min-w-0 flex-1">
                    <h4 class="text-sm font-bold text-white flex items-center gap-2 truncate">
                      <span class="w-2.5 h-2.5 rounded-full bg-brand-amber shrink-0" />
                      <span class="truncate">{place.name}</span>
                    </h4>
                    <p class="text-xs text-gray-200 line-clamp-1">
                      {place.address}
                    </p>
                    <p class="text-[11px] text-brand-green-light font-mono">
                      C.P. / ZIP: {place.zipCode}
                    </p>
                  </div>

                  <!-- External Navigation Button (Opens in Google Maps) -->
                  <a
                    href={googleMapsSearchUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 rounded-xl bg-white/15 hover:bg-brand-amber hover:text-brand-green-dark text-white transition-all shrink-0"
                    title={place.name}
                    aria-label={`Abrir ${place.name} en Google Maps`}
                    onclick="event.stopPropagation()"
                  >
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      />
                    </svg>
                  </a>
                </div>
              );
            })
          }
        </div>

      </div>

      <!-- Right Panel: Real Google Maps Iframe -->
      <div class="lg:col-span-7 rounded-3xl overflow-hidden bg-brand-green-dark relative min-h-[420px] shadow-2xl flex items-center justify-center">
        <iframe
          id="google-maps-iframe"
          title={locator.mapAlt}
          src={initialIframeSrc}
          class="w-full h-full min-h-[420px] rounded-3xl border border-white/20 shadow-2xl"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

    </div>

  </div>
</section>

<script>
  function setupStoreLocator() {
    const searchInput = document.getElementById("store-search-input") as HTMLInputElement | null;
    const storeItems = document.querySelectorAll<HTMLElement>(".store-item");
    const mapIframe = document.getElementById("google-maps-iframe") as HTMLIFrameElement | null;

    if (!mapIframe || storeItems.length === 0) return;

    // Click handler for store items
    storeItems.forEach((item) => {
      item.addEventListener("click", () => {
        const address = item.getAttribute("data-address");
        if (!address) return;

        // Update active class on store items
        storeItems.forEach((el) => {
          el.classList.remove(
            "border-brand-amber",
            "bg-white/20",
            "shadow-md",
            "ring-1",
            "ring-brand-amber/50"
          );
          el.classList.add("border-white/15", "bg-white/10");
        });

        item.classList.add(
          "border-brand-amber",
          "bg-white/20",
          "shadow-md",
          "ring-1",
          "ring-brand-amber/50"
        );
        item.classList.remove("border-white/15", "bg-white/10");

        // Update Google Maps iframe URL
        const newSrc = `https://maps.google.com/maps?q=${encodeURIComponent(
          address
        )}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
        mapIframe.src = newSrc;
      });
    });

    // Live filter handler
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        const q = searchInput.value.toLowerCase().trim();
        storeItems.forEach((item) => {
          const name = item.getAttribute("data-name")?.toLowerCase() || "";
          const address = item.getAttribute("data-address")?.toLowerCase() || "";
          const zipcode = item.getAttribute("data-zipcode")?.toLowerCase() || "";
          const combined = `${name} ${address} ${zipcode}`;

          if (combined.includes(q)) {
            item.style.display = "flex";
          } else {
            item.style.display = "none";
          }
        });
      });
    }
  }

  setupStoreLocator();
  document.addEventListener("astro:page-load", setupStoreLocator);
</script>
