---
import type { Lang } from "../../../i18n/config.i18n";
import homeContent from "../../../data/site-home-content.json";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeContent[lang] ?? homeContent.es;
const banner = t.familyBanner;
const altText = banner?.altImage || banner?.title || "Protección natural para toda la familia";
---

<section class="w-full bg-white overflow-hidden py-4 sm:py-6">
  <div class="w-full">
    <img
      src="/images/home/family-broncomiel-banner.png"
      alt={altText}
      width="1920"
      height="650"
      class="w-full h-auto object-cover max-h-[600px] sm:max-h-[700px] shadow-sm"
      loading="lazy"
    />
  </div>
</section>
