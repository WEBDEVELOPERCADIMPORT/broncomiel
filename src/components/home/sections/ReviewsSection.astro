---
import type { Lang } from "../../../i18n/config.i18n";
import homeContent from "../../../data/site-home-content.json";
import ReviewCard from "../../common/ReviewCard.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeContent[lang] ?? homeContent.es;
const reviews = t.reviews;
---

<section class="py-20 sm:py-24 bg-gray-50/70 border-y border-brand-green-border/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header with Aggregate Rating and Amazon Logo -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 mb-14 text-center sm:text-left">
      <div>
        <div class="inline-flex items-center gap-2 mb-2">
          <span class="text-2xl font-black text-brand-green-dark">
            {reviews.ratingValue}
          </span>
          <span class="text-brand-amber text-lg tracking-wider">
            {reviews.starsLabel}
          </span>
          <span class="text-xs text-gray-500 font-medium">
            {reviews.totalReviews}
          </span>
        </div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
          Amazon Customer Satisfaction
        </p>
      </div>

      <!-- Amazon Official Reviews Logo -->
      <div class="shrink-0 bg-white p-2.5 rounded-xl border border-gray-200 shadow-xs">
        <img
          src="/images/home/amazon-logo.png"
          alt={reviews.amazonLogoAlt}
          width="140"
          height="35"
          class="h-7 w-auto object-contain"
          loading="lazy"
        />
      </div>
    </div>

    <!-- 3 Review Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        reviews.items.map((item) => (
          <ReviewCard review={item} mascotAlt={reviews.amazonLogoAlt} />
        ))
      }
    </div>

  </div>
</section>
