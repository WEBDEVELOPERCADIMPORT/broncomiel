---
interface Props {
  altText: string;
}

const { altText } = Astro.props;

const slides = [
  {
    image: "/images/home/hero/family-winter-1.png",
    alt: altText,
  },
  {
    image: "/images/home/hero/family-winter-2.png",
    alt: altText,
  },
];
---

<div class="relative w-full max-w-xl mx-auto hero-carousel-container">
  <!-- Slides Container -->
  <div class="relative overflow-hidden rounded-3xl border border-white/20 shadow-2xl bg-brand-green-surface/40 aspect-5/4">
    {
      slides.map((slide, index) => (
        <div
          class={`carousel-slide absolute inset-0 transition-opacity duration-700 ease-in-out ${
            index === 0 ? "opacity-100 z-10" : "opacity-0 z-0"
          }`}
          data-slide-index={index}
        >
          <img
            src={slide.image}
            alt={slide.alt}
            width="600"
            height="480"
            class="w-full h-full object-cover"
            loading={index === 0 ? "eager" : "lazy"}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-green-dark/60 via-transparent to-transparent"></div>
        </div>
      ))
    }

    <!-- Floating Product Bottle 1 (Left / Front) -->
    <div class="absolute -bottom-6 -left-6 z-20 transition-transform duration-300 hover:scale-105 drop-shadow-2xl">
      <div class="bg-white/90 backdrop-blur-md p-2 rounded-2xl border border-brand-green-border shadow-xl">
        <img
          src="/images/products/broncomiel-jarabe-miel-y-propoleo-8-oz.png"
          alt="BroncoMiel Jarabe Adultos"
          width="140"
          height="210"
          class="w-24 sm:w-28 md:w-32 h-auto object-contain"
        />
      </div>
    </div>

    <!-- Floating Product Bottle 2 (Right / Back) -->
    <div class="absolute -bottom-4 -right-4 z-20 transition-transform duration-300 hover:scale-105 drop-shadow-2xl">
      <div class="bg-white/90 backdrop-blur-md p-2 rounded-2xl border border-brand-green-border shadow-xl">
        <img
          src="/images/products/broncolito-bote-con-tapa-dosificadora.png"
          alt="Broncolito Tapa Dosificadora"
          width="120"
          height="180"
          class="w-20 sm:w-24 md:w-28 h-auto object-contain"
        />
      </div>
    </div>
  </div>

  <!-- Carousel Indicators -->
  <div class="flex items-center justify-center gap-2 mt-4">
    {
      slides.map((_, index) => (
        <button
          type="button"
          class={`carousel-dot h-2 rounded-full transition-all duration-300 ${
            index === 0 ? "w-8 bg-brand-amber" : "w-2 bg-white/40 hover:bg-white/70"
          }`}
          data-target-index={index}
          aria-label={`Slide ${index + 1}`}
        />
      ))
    }
  </div>
</div>

<script>
  function initHeroCarousel() {
    const slides = document.querySelectorAll<HTMLElement>(".carousel-slide");
    const dots = document.querySelectorAll<HTMLElement>(".carousel-dot");
    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer: number | undefined;

    function showSlide(index: number) {
      slides.forEach((s, i) => {
        if (i === index) {
          s.classList.remove("opacity-0", "z-0");
          s.classList.add("opacity-100", "z-10");
        } else {
          s.classList.remove("opacity-100", "z-10");
          s.classList.add("opacity-0", "z-0");
        }
      });

      dots.forEach((d, i) => {
        if (i === index) {
          d.classList.remove("w-2", "bg-white/40");
          d.classList.add("w-8", "bg-brand-amber");
        } else {
          d.classList.remove("w-8", "bg-brand-amber");
          d.classList.add("w-2", "bg-white/40");
        }
      });

      currentIndex = index;
    }

    function startAutoPlay() {
      stopAutoPlay();
      timer = window.setInterval(() => {
        const nextIndex = (currentIndex + 1) % slides.length;
        showSlide(nextIndex);
      }, 5000);
    }

    function stopAutoPlay() {
      if (timer) clearInterval(timer);
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const target = Number(dot.getAttribute("data-target-index"));
        if (!isNaN(target)) {
          showSlide(target);
          startAutoPlay();
        }
      });
    });

    startAutoPlay();
  }

  initHeroCarousel();
  document.addEventListener("astro:page-load", initHeroCarousel);
</script>
