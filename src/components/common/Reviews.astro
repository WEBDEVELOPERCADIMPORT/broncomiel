---
import type { Lang } from "../../i18n/config.i18n";

export interface Review {
  name?: string;
  author?: string;
  comment?: string;
  quote?: string;
  title?: string;
  rating: number;
  date: string;
  verifiedText?: string;
}

interface Props {
  lang: Lang;
  title: string;
  ratingValue?: string;
  totalReviews?: string;
  amazonLogoAlt?: string;
  reviews: Review[] | null;
}

const {
  title,
  ratingValue = "4.8",
  totalReviews = "(1,420+)",
  amazonLogoAlt = "Amazon Reviews",
  reviews = [],
} = Astro.props;
---

<section class="w-full max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:px-8 font-sans">
  <!-- Header with Title, Amazon Logo, and Rating -->
  <header class="text-center mb-12 flex flex-col items-center justify-center">
    <h2 class="font-extrabold text-3xl sm:text-4xl text-brand-green-dark mb-5 tracking-tight">
      {title}
    </h2>

    <div class="flex flex-col items-center gap-2">
      <!-- Amazon Logo Header -->
      <img
        src="/images/home/amazon.png"
        alt={amazonLogoAlt}
        class="h-8 w-auto object-contain"
      />

      <div class="flex items-center gap-2 mt-1">
        <span class="font-bold text-xl text-gray-900">{ratingValue}</span>
        <div class="flex text-brand-amber gap-0.5">
          {
            Array.from({ length: 5 }).map(() => (
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))
          }
        </div>
        <span class="text-gray-500 font-medium text-sm ml-1">{totalReviews}</span>
      </div>
    </div>
  </header>

  <!-- Carousel Track Container -->
  <div class="relative group review-carousel-container w-full">
    <!-- Prev Button -->
    <button
      type="button"
      class="prev-btn absolute left-2 lg:-left-6 top-1/2 -translate-y-1/2 -ml-4 lg:-ml-6 z-10 bg-white rounded-full p-2.5 shadow-lg border border-gray-100 text-brand-green-primary hover:bg-brand-green-light hover:scale-105 transition-all focus:outline-hidden"
      aria-label="Anterior"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Scrollable Track -->
    <div class="review-track w-full flex overflow-x-hidden snap-x snap-mandatory gap-6 pb-8 pt-4 px-2 no-scrollbar scroll-smooth">
      {
        reviews?.map((review) => {
          const authorName = review.author || review.name || "Cliente";
          const quoteText = review.quote || review.comment || "";
          const initial = authorName.charAt(0).toUpperCase();

          return (
            <div class="snap-center shrink-0 w-[340px] md:w-[380px] bg-white border border-brand-green-border/40 rounded-[32px] p-8 shadow-sm hover:shadow-xl transition-shadow flex flex-col justify-between">
              <div>
                <!-- User Info -->
                <div class="flex items-center gap-3 mb-5">
                  <div class="w-12 h-12 rounded-full bg-brand-green-light text-brand-green-primary border border-brand-green-border flex items-center justify-center font-bold text-lg">
                    {initial}
                  </div>
                  <div class="flex flex-col">
                    <h3 class="font-bold text-brand-green-dark text-[15px] leading-tight">
                      {authorName}
                    </h3>
                    <p class="text-[13px] text-gray-400 mt-0.5">{review.date}</p>
                  </div>
                </div>

                <!-- Stars & Verified Badge -->
                <div class="flex items-center justify-between gap-2 mb-4">
                  <div class="flex text-brand-amber gap-0.5">
                    {Array.from({ length: 5 }).map((_, i) => (
                      <svg
                        class={`w-4 h-4 ${i < review.rating ? "fill-current" : "text-gray-200 fill-current"}`}
                        viewBox="0 0 20 20"
                      >
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>

                  {review.verifiedText && (
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-brand-green-primary bg-brand-green-light px-2.5 py-0.5 rounded-full border border-brand-green-border">
                      ✓ {review.verifiedText}
                    </span>
                  )}
                </div>

                {review.title && (
                  <h4 class="font-bold text-brand-green-dark text-sm mb-2 line-clamp-1">
                    {review.title}
                  </h4>
                )}

                <p class="text-[14px] text-gray-700 leading-relaxed italic">
                  "{quoteText}"
                </p>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Next Button -->
    <button
      type="button"
      class="next-btn absolute right-2 lg:-right-6 top-1/2 -translate-y-1/2 -mr-4 lg:-mr-6 z-10 bg-white rounded-full p-2.5 shadow-lg border border-gray-100 text-brand-green-primary hover:bg-brand-green-light hover:scale-105 transition-all focus:outline-hidden"
      aria-label="Siguiente"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function setupCarousels() {
    const carousels = document.querySelectorAll(".review-carousel-container");

    carousels.forEach((container) => {
      const track = container.querySelector(".review-track");
      const prevBtn = container.querySelector(".prev-btn");
      const nextBtn = container.querySelector(".next-btn");

      if (!track || !prevBtn || !nextBtn) return;

      const scrollAmount = 380;

      prevBtn.addEventListener("click", () => {
        track.scrollBy({ left: -scrollAmount, behavior: "smooth" });
      });

      nextBtn.addEventListener("click", () => {
        track.scrollBy({ left: scrollAmount, behavior: "smooth" });
      });
    });
  }

  setupCarousels();
  document.addEventListener("astro:page-load", setupCarousels);
</script>
