---
export interface ReviewData {
  author: string;
  verifiedText: string;
  date: string;
  rating: number;
  title: string;
  quote: string;
}

interface Props {
  review: ReviewData;
  mascotAlt?: string;
}

const { review, mascotAlt = "BroncoMiel" } = Astro.props;
const starCount = Math.max(1, Math.min(5, Math.round(review.rating || 5)));
---

<article class="card-product relative p-6 flex flex-col justify-between h-full bg-white">
  <div>
    <!-- Rating Stars & Verified Purchase Badge -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center text-brand-amber text-base tracking-widest" aria-label={`${starCount} / 5`}>
        {
          Array.from({ length: 5 }).map((_, index) => (
            <span class={index < starCount ? "text-brand-amber" : "text-gray-300"}>
              ★
            </span>
          ))
        }
      </div>

      <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-brand-green-primary bg-brand-green-light px-2.5 py-0.5 rounded-full border border-brand-green-border">
        ✓ {review.verifiedText}
      </span>
    </div>

    <!-- Review Title -->
    <h4 class="text-base font-bold text-brand-green-dark mb-2 line-clamp-1">
      {review.title}
    </h4>

    <!-- Review Quote -->
    <p class="text-sm text-gray-600 leading-relaxed italic mb-6">
      "{review.quote}"
    </p>
  </div>

  <!-- Review Author, Date & Mascot Accent -->
  <div class="pt-4 border-t border-brand-green-border/30 flex items-center justify-between">
    <div>
      <p class="text-sm font-semibold text-brand-green-dark">
        {review.author}
      </p>
      <p class="text-xs text-gray-400">
        {review.date}
      </p>
    </div>

    <!-- Small Bee Mascot Accent -->
    <img
      src="/images/home/mascot-winter.png"
      alt={mascotAlt}
      width="32"
      height="32"
      class="w-8 h-8 object-contain shrink-0"
      loading="lazy"
    />
  </div>
</article>
