---
import type { Lang } from "../../i18n/config.i18n";
import { getLangFromUrl, useTranslations } from "../../i18n/utils.i18n";
import globalContent from "../../data/site-global-content.json";

interface Props {
  lang?: Lang;
}

const urlLang = getLangFromUrl(Astro.url);
const { lang = urlLang } = Astro.props;
const t = globalContent[lang] ?? globalContent.es;
const { navLinks } = useTranslations(lang);

const currentPath = Astro.url.pathname;
const targetLang = lang === "es" ? "en" : "es";
const switchLangPath = currentPath.startsWith(`/${lang}`)
  ? currentPath.replace(`/${lang}`, `/${targetLang}`)
  : `/${targetLang}/`;

const switchInfo = t.switchLang;
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-brand-green-border/30 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href={`/${lang}/`} class="flex items-center gap-2 transition hover:opacity-90">
        <img
          src="/logo.png"
          alt={t.navbar.logoAlt}
          width="160"
          height="40"
          class="w-auto h-10 object-contain"
        />
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-8">
        <ul class="flex items-center gap-7 text-sm font-semibold text-brand-green-dark">
          {
            navLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="transition-colors hover:text-brand-amber py-1"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <!-- Language Switcher -->
        <a
          href={switchLangPath}
          class="btn-outline-green !py-1.5 !px-3.5 !text-xs gap-1.5 rounded-full shadow-xs"
          aria-label={switchInfo.label}
        >
          <span>{switchInfo.flag}</span>
          <span class="font-bold">{switchInfo.code}</span>
        </a>
      </nav>

      <!-- Mobile Menu Button & Lang Switcher -->
      <div class="flex items-center gap-3 md:hidden">
        <a
          href={switchLangPath}
          class="btn-outline-green !py-1 !px-2.5 !text-xs gap-1 rounded-full"
          aria-label={switchInfo.label}
        >
          <span>{switchInfo.flag}</span>
          <span class="font-bold">{switchInfo.code}</span>
        </a>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="p-2 rounded-lg text-brand-green-primary hover:bg-brand-green-light focus:outline-hidden"
          aria-label={t.navbar.menuToggleAria}
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown Navigation -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-brand-green-border/20 py-4">
      <ul class="flex flex-col gap-3">
        {
          navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="block px-3 py-2 text-base font-semibold text-brand-green-dark rounded-lg hover:bg-brand-green-light hover:text-brand-green-primary transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

  </div>
</header>

<script>
  function setupNavbar() {
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!toggle || !menu) return;

    toggle.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });

    const links = menu.querySelectorAll("a");
    links.forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
      });
    });
  }

  setupNavbar();
  document.addEventListener("astro:page-load", setupNavbar);
</script>
