---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - No encontrado | BroncoMiel" lang="es">
  <section class="min-h-[70vh] flex flex-col justify-center items-center text-center px-4 py-16">
    <span class="text-8xl sm:text-9xl font-black text-brand-green-light">404</span>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-brand-green-dark mt-4">
      Página no encontrada
    </h1>
    <p class="text-sm sm:text-base text-gray-600 mt-2 mb-8 max-w-md">
      La página que buscas no existe o fue movida. Regresa al inicio para encontrar nuestras soluciones respiratorias.
    </p>
    <a 
      href="/es/" 
      class="btn-primary-amber"
    >
      Volver al Inicio
    </a>
  </section>
</Layout>
