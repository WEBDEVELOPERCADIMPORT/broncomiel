---
import Layout from '../../layouts/Layout.astro';
import homeContent from '../../data/site-home-content.json';
import { LANGUAGES, type Lang } from '../../i18n/config.i18n';
import { actions } from 'astro:actions';
import Hero from '../../components/home/sections/Hero.astro';
import WhyChoose from '../../components/home/sections/WhyChoose.astro';
import FeaturedProducts from '../../components/home/sections/FeaturedProducts.astro';
import FamilyBanner from '../../components/home/sections/FamilyBanner.astro';
import Reviews from '../../components/common/Reviews.astro';
import StoreLocator from '../../components/home/sections/StoreLocator.astro';
import FaqSection from '../../components/home/sections/FaqSection.astro';

const lang = Astro.params.lang as Lang;

if (!(lang in LANGUAGES) || !(lang in homeContent)) {
  return Astro.redirect('/404');
}

const content = homeContent[lang];

// Fetch featured products using Server Action with active language
const { data: response } = await Astro.callAction(actions.getFeaturedProducts, { lang });
const products = response?.data ?? [];

// Fetch places for the store locator
const { data: placesResponse } = await Astro.callAction(actions.getPlaces, {});
const places = placesResponse?.data ?? [];
---

<Layout
  title={content.brandName}
  lang={lang}
  description={content.meta?.description}
>
  <Hero lang={lang} />
  <WhyChoose lang={lang} />
  <FeaturedProducts lang={lang} products={products} />
  <FamilyBanner lang={lang} />
  <Reviews
    lang={lang}
    title={content.reviews.sectionTitle}
    ratingValue={content.reviews.ratingValue}
    totalReviews={content.reviews.totalReviews}
    amazonLogoAlt={content.reviews.amazonLogoAlt}
    reviews={content.reviews.items}
  />
  <StoreLocator lang={lang} places={places} />
  <FaqSection lang={lang} />
</Layout>
